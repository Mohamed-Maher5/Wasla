# This file documents the environment variables Wasla expects before it starts.
# It gives developers safe placeholder values without exposing real secrets.

DATABASE_URL=postgresql://wasla:wasla@localhost:5433/wasla
JWT_SECRET=change-me-in-production
VONAGE_APPLICATION_ID=00000000-0000-0000-0000-000000000000
VONAGE_PRIVATE_KEY_PATH=/path/to/private.key
VONAGE_FROM_NUMBER=+10000000000
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok-free.app
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GROQ_LLM_API_KEY=